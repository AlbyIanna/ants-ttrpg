{
  "version": "v0.5",
  "purpose": "Modern Vite-based system design for Ant Colony TTRPG Prototype - ES6 modules with pixel art Canvas rendering and hot module reload",
  "architecture_type": "browser-first_modular_components",
  "modules": [
    {
      "name": "main_application",
      "description": "Core application controller with Vite HMR integration and component coordination",
      "interface": {
        "inputs": ["user_interactions", "component_updates", "hmr_events"],
        "outputs": ["ui_updates", "state_changes", "error_handling"],
        "dependencies": ["utils", "web_simulation", "pixel_renderer"]
      },
      "file_path": "/src/main.js"
    },
    {
      "name": "web_simulation",
      "description": "Modern ES6 simulation engine with ant AI, environment generation, and colony management",
      "interface": {
        "inputs": ["user_commands", "environment_config", "time_delta"],
        "outputs": ["simulation_state", "ant_behaviors", "colony_stats"],
        "dependencies": ["utils"]
      },
      "file_path": "/src/components/web-simulation.js"
    },
    {
      "name": "pixel_renderer",
      "description": "HTML5 Canvas-based pixel art renderer with 450×300 display and 6×6 tile sprites",
      "interface": {
        "inputs": ["simulation_state", "display_options", "user_interactions"],
        "outputs": ["canvas_graphics", "interaction_events", "performance_metrics"],
        "dependencies": ["utils"]
      },
      "file_path": "/src/components/pixel-renderer.js"
    },
    {
      "name": "utils",
      "description": "Utility functions, performance monitoring, DOM helpers, and event management",
      "interface": {
        "inputs": ["utility_requests", "performance_measurements", "storage_operations"],
        "outputs": ["helper_functions", "performance_data", "event_handling"],
        "dependencies": []
      },
      "file_path": "/src/components/utils.js"
    },
    {
      "name": "vite_build_system",
      "description": "Modern build tooling with hot module reload, ES6 processing, and production optimization",
      "interface": {
        "inputs": ["source_files", "configuration", "development_mode"],
        "outputs": ["bundled_assets", "hmr_updates", "build_artifacts"],
        "dependencies": ["package.json"]
      },
      "file_path": "/vite.config.js"
    },
    {
      "name": "rule_schemas",
      "description": "JSON schemas defining game rules, resources, ant behaviors, and environmental mechanics",
      "interface": {
        "inputs": ["schema_requests", "validation_data"],
        "outputs": ["rule_definitions", "validation_results"],
        "dependencies": []
      },
      "file_path": "/rules/*.json"
    },
    {
      "name": "legacy_simulation_modules",
      "description": "Original simulation engine modules kept for reference and potential CLI version",
      "interface": {
        "inputs": ["legacy_compatibility_mode"],
        "outputs": ["terminal_simulation", "rule_processing"],
        "dependencies": ["rule_schemas"]
      },
      "file_path": "/sims/*.js"
    }
  ],
  "simulation_systems": {
    "ant_behavior_system": {
      "roles": {
        "worker": {
          "behaviors": ["foraging", "food_collection", "nest_building"],
          "color": "#22c55e",
          "sprite_size": "6x6_pixels",
          "ai_complexity": "medium"
        },
        "scout": {
          "behaviors": ["exploring", "food_discovery", "path_finding"],
          "color": "#3b82f6", 
          "sprite_size": "6x6_pixels",
          "ai_complexity": "high"
        },
        "soldier": {
          "behaviors": ["patrolling", "threat_detection", "colony_defense"],
          "color": "#dc2626",
          "sprite_size": "6x6_pixels",
          "ai_complexity": "medium"
        }
      },
      "ai_features": [
        "state_machine_behaviors",
        "role_based_decision_making",
        "environmental_awareness",
        "food_trail_following",
        "energy_management"
      ]
    },
    "environment_system": {
      "world_size": "75x50_tiles",
      "pixel_size": "6x6_per_tile",
      "canvas_size": "450x300_pixels",
      "terrain_types": [
        "empty_space",
        "grass_tiles",
        "rock_obstacles", 
        "water_features",
        "nest_structures"
      ],
      "food_sources": [
        "berries",
        "seeds",
        "nectar",
        "wood_materials"
      ],
      "generation": "procedural_with_balance"
    },
    "rendering_system": {
      "technology": "html5_canvas_2d",
      "performance_target": "60_fps",
      "sprite_rendering": "pixel_perfect_6x6",
      "optimization": [
        "hardware_acceleration",
        "minimal_redraws",
        "efficient_pixel_operations"
      ],
      "interactions": [
        "mouse_click_detection",
        "hover_tooltips", 
        "keyboard_shortcuts"
      ]
    }
  },
  "development_experience": {
    "hot_module_reload": {
      "update_speed": "~50ms_average",
      "supported_files": ["js", "css", "html"],
      "state_preservation": "simulation_continues_during_updates"
    },
    "build_performance": {
      "dev_server_start": "~141ms",
      "production_build": "~174ms",
      "bundle_size": "28kb_js_5kb_css_gzipped"
    },
    "developer_tools": [
      "vite_error_overlay",
      "source_maps",
      "network_access",
      "performance_monitoring"
    ]
  },
  "folder_structure": {
    "/src/": {
      "main.js": "Application entry point with component coordination",
      "components/utils.js": "Utility functions and performance tools",
      "components/web-simulation.js": "Modern simulation engine with ES6 modules",
      "components/pixel-renderer.js": "Canvas-based pixel art rendering system",
      "styles/styles.css": "Application styling and responsive design"
    },
    "/public/": {
      "description": "Static assets served by Vite"
    },
    "/rules/": {
      "resource-schema.json": "Resource management and consumption rules",
      "event-schema.json": "Environmental events and triggers",
      "action-schema.json": "Valid player actions and effects"
    },
    "/sims/": {
      "description": "Legacy simulation modules for reference",
      "status": "deprecated_but_maintained"
    },
    "/": {
      "index.html": "Main HTML entry point for Vite",
      "package.json": "NPM dependencies and build scripts",
      "vite.config.js": "Build configuration and development server",
      "ARCHITECTURE.md": "Detailed technical documentation"
    }
  },
  "example_user_flow": [
    {
      "step": 1,
      "action": "npm run dev",
      "result": "Vite starts development server with HMR"
    },
    {
      "step": 2,
      "action": "open http://localhost:8000",
      "result": "Browser loads main.js and initializes components"
    },
    {
      "step": 3,
      "action": "main.js imports and creates WebSimulation",
      "result": "Simulation generates 75x50 world with ants"
    },
    {
      "step": 4,
      "action": "main.js creates PixelRenderer",
      "result": "Canvas initialized with 450x300 pixel display"
    },
    {
      "step": 5,
      "action": "user clicks play button",
      "result": "Simulation loop starts at 60fps with ant AI"
    },
    {
      "step": 6,
      "action": "user clicks on ant",
      "result": "Modal shows ant details (role, state, energy)"
    },
    {
      "step": 7,
      "action": "developer edits pixel-renderer.js",
      "result": "Vite HMR updates component in ~50ms"
    }
  ],
  "performance_benchmarks": {
    "simulation_loop": "16ms_per_frame_60fps",
    "canvas_rendering": "8ms_per_frame",
    "hmr_updates": "50ms_average",
    "production_bundle": "28kb_js_5kb_css",
    "memory_usage": "efficient_pixel_sprite_caching"
  },
  "technical_innovations": [
    "vite_hmr_integration_with_state_preservation",
    "es6_modular_architecture_without_frameworks",
    "pixel_perfect_canvas_rendering_6x6_sprites",
    "efficient_ant_ai_with_role_based_behaviors",
    "responsive_design_with_mobile_compatibility"
  ],
  "changelog": [
    {
      "version": "v0.5",
      "date": "2025-09-12",
      "changes": [
        "Complete migration to Vite-based development architecture",
        "ES6 modules with clean import/export system",
        "HTML5 Canvas pixel art rendering with 6x6 sprites",
        "Hot Module Reload with component state preservation", 
        "Modern build system with production optimization",
        "Expanded world size to 75x50 tiles (3,750 vs previous 700)",
        "Enhanced ant AI with role-specific behaviors and colors",
        "Performance optimizations achieving 60fps target",
        "Comprehensive documentation with Mermaid diagrams",
        "Legacy code cleanup while maintaining reference modules"
      ]
    },
    {
      "version": "v1.0", 
      "date": "2025-09-11",
      "changes": [
        "Initial system design document created",
        "Defined 9 core modules with clear interfaces",
        "Mapped modules to existing folder structure",
        "Created example turn flow demonstrating interactions",
        "Established architecture supporting swarm intelligence"
      ]
    }
  ]
}